# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C / C++ extensions & build artifacts
*.so
*.dylib
*.dll
*.o
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Data caches (reproducible via src/data_loader.py)
data/raw/*.parquet
data/raw/*.csv
data/processed/*.parquet
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Testing & linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# macOS & IDE
.DS_Store
.idea/
*.swp
